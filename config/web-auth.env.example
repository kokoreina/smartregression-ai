# Copy to var/auth/web.env (ignored). Never put real secrets in this template.
# SMARTREGRESSION_WEB_MODE must be set in the server process before app import:
# local-demo retains existing loopback demo routes; product disables them.
SMARTREGRESSION_AUTH_LOCAL_HTTP=1
SMARTREGRESSION_FRONTEND_ORIGIN=http://127.0.0.1:5173
# Generate >=32 random bytes and encode them as a long random string.
SMARTREGRESSION_CSRF_SECRET=
# Runtime user: SELECT/INSERT/UPDATE on web auth tables, no schema DDL privileges.
SMARTREGRESSION_DATABASE_URL=
# Migration credentials are separate; never use them as the application identity.
SMARTREGRESSION_MIGRATION_DATABASE_URL=
# Gmail 2-step verification + App Password. Do not use your account login password.
SMARTREGRESSION_SMTP_USERNAME=
SMARTREGRESSION_SMTP_PASSWORD=

# Optional future backend credentials only. No provider is selected.
# Never expose credentials through VITE_* variables.
# FUTURE_PROVIDER_API_KEY=replace_me

# PostgreSQL 2.20-B: backend only, read explicitly by DB-capable composition.
# Existing analyze/health do not require or use these settings yet.
# Percent-encode special password characters; never commit a real URL.
# Remote TLS defaults to sslmode=verify-full. Optional query: sslrootcert=/absolute/path/to/ca.pem
# Only sslmode and sslrootcert query options are supported. Timeouts use the variables below.
# SMARTREGRESSION_DATABASE_URL=postgresql+psycopg://runtime_user:replace_me@db.example.invalid/smartregression
# SMARTREGRESSION_MIGRATION_DATABASE_URL=postgresql+psycopg://migration_owner:replace_me@db.example.invalid/smartregression
# SMARTREGRESSION_DB_CONNECT_TIMEOUT_SECONDS=5
# SMARTREGRESSION_DB_STATEMENT_TIMEOUT_MS=10000
# SMARTREGRESSION_DB_LOCK_TIMEOUT_MS=3000
# Migration URL is read only with migration=True; no fallback to owner credentials.
# Plaintext loopback is an explicit dedicated-test caller option, not an env switch.
# No artifact publisher or SMARTREGRESSION_ARTIFACT_ROOT consumer is implemented in 2.20-B.
